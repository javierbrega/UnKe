{
  "name": "unke-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=dashboard-merchant",
    "dev:closer": "turbo run dev --filter=dashboard-closer",
    "dev:landing": "turbo run dev --filter=landing",
